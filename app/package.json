{
  "name": "stocktool-app",
  "private": true,
  "version": "1.7.4",
  "type": "module",
  "description": "选股/选基金助手：载入知识库、配置自己的 LLM、带全局记忆的多会话分析",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5273",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5274",
    "typecheck": "vue-tsc --noEmit",
    "test": "esbuild tests/smoke.ts --bundle --platform=node --format=esm --target=node20 --outfile=tests/smoke.mjs --alias:@=./src && node tests/smoke.mjs",
    "test:dom": "vitest run --config vitest.config.ts",
    "test:live": "node tests/live_search.mjs",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:dom && pnpm test:layout",
    "test:everything": "pnpm test:all && pnpm test:live",
    "sync-version": "node scripts/sync-version.mjs",
    "apk": "node scripts/build-apk.mjs",
    "apk:patch": "node scripts/build-apk.mjs --bump patch",
    "apk:minor": "node scripts/build-apk.mjs --bump minor",
    "apk:raw": "node scripts/build-apk.mjs --no-bump",
    "ship": "pnpm typecheck && pnpm test && pnpm test:dom && pnpm test:layout && pnpm apk",
    "ship:minor": "pnpm typecheck && pnpm test && pnpm test:dom && pnpm test:layout && pnpm apk:minor",
    "test:layout": "node tools/run_composer_layout_test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "fflate": "^0.8.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.0"
  }
}
